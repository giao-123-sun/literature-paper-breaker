# LLM Provider API Keys (at least one required)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Academic Data Source Credentials (optional - enables premium access)
# Semantic Scholar - free, no key needed for basic access
SEMANTIC_SCHOLAR_API_KEY=

# OpenAlex - free, email recommended for polite pool
OPENALEX_EMAIL=your@email.com

# CORE (core.ac.uk) - free API key
CORE_API_KEY=

# Springer Nature API
SPRINGER_API_KEY=

# User-provided institutional credentials (for CNKI, JSTOR, etc.)
# These are used via browser automation with user consent
INSTITUTIONAL_PROXY_URL=
INSTITUTIONAL_USERNAME=
INSTITUTIONAL_PASSWORD=
